        $module['key'],
        $source['record_uid'],
        ((int)$source['version_no']) + 1,
        $payload,
        $common,
        'SOFT_DELETE',
        $reason,
        $source,
        true,
        'DELETED'
    );
}

function module_persist_new_version(
