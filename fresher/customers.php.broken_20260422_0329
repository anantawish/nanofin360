<?php
declare(strict_types=1);

require_once __DIR__ . '/bootstrap.php';

$customerDocumentUploads = [
    'doc_id_card' => ['column' => 'doc_id_card_path', 'sub_dir' => 'docs/id_card', 'label' => 'เอกสารบัตรประชาชน'],
    'doc_house_reg' => ['column' => 'doc_house_reg_path', 'sub_dir' => 'docs/house_reg', 'label' => 'เอกสารทะเบียนบ้าน'],
    'doc_vehicle_ownership' => ['column' => 'doc_vehicle_ownership_path', 'sub_dir' => 'docs/vehicle_ownership', 'label' => 'เอกสารครอบครองรถยนต์'],
    'doc_land_ownership' => ['column' => 'doc_land_ownership_path', 'sub_dir' => 'docs/land_ownership', 'label' => 'เอกสารครอบครองที่ดิน'],
];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        verify_csrf_or_fail((string)($_POST['csrf_token'] ?? ''));
        $action = trim((string)($_POST['action'] ?? 'save'));
        $actor = current_user_name();
        $now = now_dt();

        if ($action === 'delete') {
            $id = fresher_int($_POST['id'] ?? 0);
            if ($id <= 0) {
                throw new RuntimeException('ไม่พบรายการลูกค้าที่ต้องการลบ');
            }

            $scope = fresher_scope_clause('branch_code', 'fr_cus_del');
            $stmtFind = db()->prepare(
                'SELECT branch_code
                 FROM fresher_customers
                 WHERE id = :id AND is_deleted = 0' . $scope['sql'] . '
                 LIMIT 1'
            );
            $params = $scope['params'];
            $params[':id'] = $id;
            $stmtFind->execute($params);
            $row = $stmtFind->fetch();
            if (!$row) {
                throw new RuntimeException('ไม่พบข้อมูลลูกค้าหรือไม่มีสิทธิ์ลบ');
            }
            assert_branch_in_current_scope((string)$row['branch_code']);

            $stmtDel = db()->prepare(
                'UPDATE fresher_customers
                 SET is_deleted = 1,
                     deleted_by = :deleted_by,
                     deleted_at = :deleted_at,
                     updated_by = :updated_by,
                     updated_at = :updated_at
                 WHERE id = :id'
            );
            $stmtDel->execute([
                ':deleted_by' => $actor,
                ':deleted_at' => $now,
                ':updated_by' => $actor,
                ':updated_at' => $now,
                ':id' => $id,
            ]);
            add_flash('warning', 'ลบข้อมูลลูกค้าแบบ soft delete เรียบร้อย');
        } else {
            $id = fresher_int($_POST['id'] ?? 0);
            $firstName = trim((string)($_POST['first_name'] ?? ''));
            $lastName = trim((string)($_POST['last_name'] ?? ''));
            $phone = trim((string)($_POST['phone_number'] ?? ''));
            $cid = trim((string)($_POST['cid_tax_id'] ?? ''));
            $address = trim((string)($_POST['address_line'] ?? ''));
            $subdistrict = trim((string)($_POST['subdistrict'] ?? ''));
            $district = trim((string)($_POST['district'] ?? ''));
            $province = trim((string)($_POST['province'] ?? ''));
            $occupation = trim((string)($_POST['occupation'] ?? ''));
            $monthlyIncome = max(0, fresher_decimal($_POST['monthly_income'] ?? 0));
            $dependents = max(0, fresher_int($_POST['family_dependents'] ?? 0));
            $attitudeScore = max(0, min(100, fresher_decimal($_POST['attitude_score'] ?? 0)));
            $branchCode = strtoupper(trim((string)($_POST['branch_code'] ?? '')));
            $note = trim((string)($_POST['note_text'] ?? ''));
            $status = strtoupper(trim((string)($_POST['customer_status'] ?? 'ACTIVE')));
            if ($status === '') {
                $status = 'ACTIVE';
            }

            if ($firstName === '' || $lastName === '' || $branchCode === '') {
                throw new RuntimeException('กรุณากรอกข้อมูลลูกค้าให้ครบ (ชื่อ/นามสกุล/สาขา)');
            }
            assert_branch_in_current_scope($branchCode);

            $photo = fresher_upload_file('customer_photo', 'images', ['jpg', 'jpeg', 'png', 'webp'], 8 * 1024 * 1024);
            $documentUploads = [];
            foreach ($customerDocumentUploads as $uploadField => $config) {
                $column = (string)$config['column'];
                $documentUploads[$column] = fresher_upload_file((string)$uploadField, (string)$config['sub_dir'], ['pdf', 'jpg', 'jpeg', 'png', 'webp'], 12 * 1024 * 1024);
            }

            $photoPath = '';
            $documentPaths = [];

            if ($id > 0) {
                $scope = fresher_scope_clause('branch_code', 'fr_cus_up');
                $stmtFind = db()->prepare(
                    'SELECT customer_code, customer_photo_path,
                            doc_id_card_path, doc_house_reg_path, doc_vehicle_ownership_path, doc_land_ownership_path,
                            branch_code
                     FROM fresher_customers
                     WHERE id = :id AND is_deleted = 0' . $scope['sql'] . '
                     LIMIT 1'
                );
                $params = $scope['params'];
                $params[':id'] = $id;
                $stmtFind->execute($params);
                $existing = $stmtFind->fetch();
                if (!$existing) {
                    throw new RuntimeException('ไม่พบลูกค้าที่ต้องการแก้ไข');
                }
                assert_branch_in_current_scope((string)$existing['branch_code']);

                $photoPath = (string)($existing['customer_photo_path'] ?? '');
                if (is_array($photo)) {
                    $photoPath = (string)$photo['file_path'];
                }
                foreach ($customerDocumentUploads as $config) {
                    $column = (string)$config['column'];
                    $documentPaths[$column] = (string)($existing[$column] ?? '');
                    if (is_array($documentUploads[$column] ?? null)) {
                        $documentPaths[$column] = (string)$documentUploads[$column]['file_path'];
                    }
                }

                $stmt = db()->prepare(
                    'UPDATE fresher_customers
                     SET first_name = :first_name,
                         last_name = :last_name,
                         phone_number = :phone_number,
                         cid_tax_id = :cid_tax_id,
                         address_line = :address_line,
                         subdistrict = :subdistrict,
                         district = :district,
                         province = :province,
                         occupation = :occupation,
                         monthly_income = :monthly_income,
                         family_dependents = :family_dependents,
                         attitude_score = :attitude_score,
                         branch_code = :branch_code,
                         customer_photo_path = :customer_photo_path,
                         doc_id_card_path = :doc_id_card_path,
                         doc_house_reg_path = :doc_house_reg_path,
                         doc_vehicle_ownership_path = :doc_vehicle_ownership_path,
                         doc_land_ownership_path = :doc_land_ownership_path,
                         note_text = :note_text,
                         customer_status = :customer_status,
                         updated_by = :updated_by,
                         updated_at = :updated_at
                     WHERE id = :id'
                );
                $stmt->execute([
                    ':first_name' => $firstName,
                    ':last_name' => $lastName,
                    ':phone_number' => $phone,
                    ':cid_tax_id' => $cid,
                    ':address_line' => $address,
                    ':subdistrict' => $subdistrict,
                    ':district' => $district,
                    ':province' => $province,
                    ':occupation' => $occupation,
                    ':monthly_income' => $monthlyIncome,
                    ':family_dependents' => $dependents,
                    ':attitude_score' => $attitudeScore,
                    ':branch_code' => $branchCode,
                    ':customer_photo_path' => $photoPath,
                    ':doc_id_card_path' => $documentPaths['doc_id_card_path'] ?? '',
                    ':doc_house_reg_path' => $documentPaths['doc_house_reg_path'] ?? '',
                    ':doc_vehicle_ownership_path' => $documentPaths['doc_vehicle_ownership_path'] ?? '',
                    ':doc_land_ownership_path' => $documentPaths['doc_land_ownership_path'] ?? '',
                    ':note_text' => $note,
                    ':customer_status' => $status,
                    ':updated_by' => $actor,
                    ':updated_at' => $now,
                    ':id' => $id,
                ]);
                add_flash('success', 'แก้ไขข้อมูลลูกค้าเรียบร้อย');
            } else {
                if (is_array($photo)) {
                    $photoPath = (string)$photo['file_path'];
                }
                foreach ($customerDocumentUploads as $config) {
                    $column = (string)$config['column'];
                    $documentPaths[$column] = '';
                    if (is_array($documentUploads[$column] ?? null)) {
                        $documentPaths[$column] = (string)$documentUploads[$column]['file_path'];
                    }
                }

                $customerCode = fresher_generate_code('FRCUS');
                $stmt = db()->prepare(
                    'INSERT INTO fresher_customers (
                        customer_code, first_name, last_name, phone_number, cid_tax_id,
                        address_line, subdistrict, district, province, occupation,
                        monthly_income, family_dependents, attitude_score, branch_code,
                        customer_photo_path, doc_id_card_path, doc_house_reg_path, doc_vehicle_ownership_path, doc_land_ownership_path,
                        note_text, customer_status,
                        is_deleted, created_by, created_at
                     ) VALUES (
                        :customer_code, :first_name, :last_name, :phone_number, :cid_tax_id,
                        :address_line, :subdistrict, :district, :province, :occupation,
                        :monthly_income, :family_dependents, :attitude_score, :branch_code,
                        :customer_photo_path, :doc_id_card_path, :doc_house_reg_path, :doc_vehicle_ownership_path, :doc_land_ownership_path,
                        :note_text, :customer_status,
                        0, :created_by, :created_at
                     )'
                );
                $stmt->execute([
                    ':customer_code' => $customerCode,
                    ':first_name' => $firstName,
                    ':last_name' => $lastName,
                    ':phone_number' => $phone,
                    ':cid_tax_id' => $cid,
                    ':address_line' => $address,
                    ':subdistrict' => $subdistrict,
                    ':district' => $district,
                    ':province' => $province,
                    ':occupation' => $occupation,
                    ':monthly_income' => $monthlyIncome,
                    ':family_dependents' => $dependents,
                    ':attitude_score' => $attitudeScore,
                    ':branch_code' => $branchCode,
                    ':customer_photo_path' => $photoPath,
                    ':doc_id_card_path' => $documentPaths['doc_id_card_path'] ?? '',
                    ':doc_house_reg_path' => $documentPaths['doc_house_reg_path'] ?? '',
                    ':doc_vehicle_ownership_path' => $documentPaths['doc_vehicle_ownership_path'] ?? '',
                    ':doc_land_ownership_path' => $documentPaths['doc_land_ownership_path'] ?? '',
                    ':note_text' => $note,
                    ':customer_status' => $status,
                    ':created_by' => $actor,
                    ':created_at' => $now,
                ]);
                add_flash('success', 'เพิ่มลูกค้าเรียบร้อย รหัสลูกค้า: ' . $customerCode);
            }
